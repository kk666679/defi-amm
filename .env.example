# ── Hardhat Local (chain ID 31337) ───────────────────────────────────────────
# Written automatically by: npx hardhat run scripts/deploy-amm.ts --network localhost
NEXT_PUBLIC_AMM_ADDRESS=
NEXT_PUBLIC_TOKEN_A_ADDRESS=
NEXT_PUBLIC_TOKEN_B_ADDRESS=
NEXT_PUBLIC_HARDHAT_RPC_URL=http://127.0.0.1:8545

# ── Sepolia testnet (chain ID 11155111) ───────────────────────────────────────
# Copy from the in-app deployment panel after deploying on Sepolia
NEXT_PUBLIC_SEPOLIA_AMM_ADDRESS=
NEXT_PUBLIC_SEPOLIA_TOKEN_A_ADDRESS=
NEXT_PUBLIC_SEPOLIA_TOKEN_B_ADDRESS=
# Safe to expose — uses a public endpoint; never put a private API key here
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── Server-only secrets (never use NEXT_PUBLIC_ prefix) ──────────────────────
# Example: DEPLOYER_PRIVATE_KEY=<private_key>
# Keep all private keys out of this file and out of version control.

# ── Database (Prisma) ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
